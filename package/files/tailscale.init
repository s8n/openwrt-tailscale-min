#!/bin/sh /etc/rc.common

# tailscaled is stored gzipped on flash and unpacked to RAM on every start.

USE_PROCD=1
START=80

DAEMON_GZ=/usr/lib/tailscale/tailscaled.gz

daemon_path() {
	config_load tailscale
	config_get daemon settings daemon_path /tmp/tailscaled
}

start_service() {
	local std_err std_out port state_file fw_mode daemon

	config_load tailscale
	config_get_bool std_out settings log_stdout 1
	config_get_bool std_err settings log_stderr 1
	config_get port settings port 41641
	config_get state_file settings state_file /etc/tailscale/tailscaled.state
	config_get fw_mode settings fw_mode nftables
	daemon_path

	# Don't swap the binary or clean up the network config under an
	# already-running daemon (e.g. `start` while running).
	if ! procd_running tailscale || [ ! -x "$daemon" ]; then
		mkdir -p "${daemon%/*}"
		if ! gunzip -c "$DAEMON_GZ" > "$daemon.tmp"; then
			rm -f "$daemon.tmp"
			echo "tailscale: failed to unpack $DAEMON_GZ to $daemon (out of space?)" >&2
			return 1
		fi
		chmod 755 "$daemon.tmp"
		mv -f "$daemon.tmp" "$daemon"
		"$daemon" --cleanup
	fi

	procd_open_instance
	procd_set_param command "$daemon"
	procd_append_param command --port "$port"
	procd_append_param command --state "$state_file"
	procd_set_param env TS_DEBUG_FIREWALL_MODE="$fw_mode"
	procd_append_param env TS_NO_LOGS_NO_SUPPORT=true
	procd_set_param respawn
	procd_set_param stdout "$std_out"
	procd_set_param stderr "$std_err"
	procd_close_instance
}

stop_service() {
	daemon_path
	[ -x "$daemon" ] && "$daemon" --cleanup
}

service_stopped() {
	# Free the RAM once the daemon is gone; it's unpacked again on start.
	daemon_path
	rm -f "$daemon"
}
